@model IEnumerable<NewLifeHospitalSolution.Models.Patient>

@{
    ViewData["Title"] = "ViewPatients";
}

<h1>Patients List</h1>

<p>
    <a asp-controller="Patient"
           asp-action="RegisterForMembership"
           class="btn btn-primary">

        Create New Membership

    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Patient Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Blood Group</th>
            <th>Contact Number</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.ID</td>
                <td>@item.PatientName</td>
                <td>@item.Age</td>
                <td>@item.Gender</td>
                <td>@item.BloodGroup</td>
                <td>@item.ContactNumber</td>
                <td>@item.EmailID</td>

                <td>

                    <a asp-controller="Patient"
                           asp-action="UpdateEmail"
                           class="btn btn-warning">

                        Update Email

                    </a>

                    <a asp-controller="Patient"
                           asp-action="CancelMembership"
                           class="btn btn-danger">

                        Delete

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>